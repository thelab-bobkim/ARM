# ARM Platform Environment Variables
# ⚠️ 이 파일을 복사하여 .env.prod 파일을 생성하고 실제 값으로 채우세요
# cp .env.example .env.prod

# ────────────────────────────────
# 데이터베이스
# ────────────────────────────────
DB_PASSWORD=your_strong_password_here

# ────────────────────────────────
# 다우오피스 OpenAPI
# 발급: 다우오피스 고객포털 → API 신청
# ────────────────────────────────
DAOU_CLIENT_ID=your_daou_client_id
DAOU_CLIENT_SECRET=your_daou_client_secret

# ────────────────────────────────
# 우리카드 OpenAPI
# 발급: https://apiportal.wooricard.com
# ────────────────────────────────
WOORI_CLIENT_ID=your_woori_client_id
WOORI_CLIENT_SECRET=your_woori_client_secret

# ────────────────────────────────
# CODEF API (신한, 삼성, 현대 등 14개사)
# 발급: https://developer.codef.io
# ────────────────────────────────
CODEF_CLIENT_ID=your_codef_client_id
CODEF_CLIENT_SECRET=your_codef_client_secret

# ────────────────────────────────
# OpenAI API (GPT-4o Vision 폴백)
# 발급: https://platform.openai.com
# ────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key

# ────────────────────────────────
# 보안
# ────────────────────────────────
JWT_SECRET=your_very_long_random_jwt_secret_at_least_32_chars
FERNET_KEY=your_fernet_encryption_key

# ────────────────────────────────
# 서버
# ────────────────────────────────
SERVER_URL=https://13.125.110.156
ENV=production
